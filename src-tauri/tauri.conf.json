{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tide",
  "version": "1.0.0",
  "identifier": "site.tide.vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tide",
        "width": 1000,
        "height": 660,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "backgroundColor": "#2E3440",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "tide VPN",
    "copyright": "tide",
    "externalBin": [
      "binaries/sing-box"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ru-RU"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}